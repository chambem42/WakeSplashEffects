<Project Sdk="Microsoft.NET.Sdk">

    <!--
        Runs WakeSplashEffects' in-game tests in KSP with dotnet test: every [UITest] in WakeSplashEffects.KspTests is a test here. It
        deploys the KspTest harness and the test assembly into a KSP instance with the mods below, starts KSP on a sandbox
        game with crafts/ in its save, and passes when the in-game test does.
    -->
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <RollForward>Major</RollForward>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
        <PackageReference Include="xunit" Version="2.9.3" />
        <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\WakeSplashEffects.KspTests\WakeSplashEffects.KspTests.csproj"
                          ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" OutputItemType="KspTestPlugin" />
    </ItemGroup>

    <ItemGroup>
        <!-- FAR (its water model makes the slam; KSPBurst its jobs need) and ProceduralParts from CKAN, with FarGameData's FAR build over CKAN's;
             this mod from source; the test parts' patches. (CustomProceduralParts, a repository at a commit: the tests' Mods)
             FAR pinned to a testing release (CKAN's testing channel) with the water model (#193) until a stable one has it -->
        <KspMod Include="FerramAerospaceResearchContinued=3:0.17.0.4;KSPBurst;ProceduralParts" />
        <KspOverlay Include="$(FarGameData)" Condition="'$(FarGameData)' != ''" />
        <KspMod Include="..\..\GameData\WakeSplashEffects" />
        <KspMod Include="mods\WakeSplashEffectsTests" />
    </ItemGroup>

    <ItemGroup>
        <KspTestCraft Include="crafts/*.craft" />
        <None Include="ksptest.json" Condition="Exists('ksptest.json')" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <Import Project="$(KspTestRoot)/build/KspTest.FromSource.targets" />

</Project>
