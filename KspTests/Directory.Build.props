<Project>
  <!-- Local paths (gitignored): Directory.Build.props.user sets KspDir and FarGameData for this machine -->
  <Import Project="Directory.Build.props.user" Condition="Exists('Directory.Build.props.user')" />
  <PropertyGroup>
    <!-- the KSP install the in-game tests are built against: KspDir, else the KSPDIR environment variable -->
    <KspDir Condition="'$(KspDir)' == ''">$(KSPDIR)</KspDir>
    <!-- the KspTest submodule; KSPTEST_ROOT (or KspTestRoot) points at another checkout -->
    <KspTestRoot Condition="'$(KspTestRoot)' == ''">$(KSPTEST_ROOT)</KspTestRoot>
    <KspTestRoot Condition="'$(KspTestRoot)' == ''">$(MSBuildThisFileDirectory)KspTest</KspTestRoot>
    <!-- a FAR build with its water model (GameData/FerramAerospaceResearch laid out), laid over CKAN's FAR: FarGameData,
         else the environment's. Until a FAR release has the water model, the splash tests need one -->
    <FarGameData Condition="'$(FarGameData)' == ''">$(FAR_GAMEDATA)</FarGameData>
  </PropertyGroup>
</Project>
